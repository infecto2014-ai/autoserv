# Локальный PostgreSQL из compose.yaml. Замените placeholder в DATABASE_URL.
# Пароль в URI должен быть percent-encoded; POSTGRES_PASSWORD — исходное значение.
DATABASE_URL="postgresql://sto:<PASSWORD_URL_ENCODED>@127.0.0.1:5432/sto_crm?schema=public"
POSTGRES_DB=sto_crm
POSTGRES_USER=sto
POSTGRES_PASSWORD=

# Точный публичный origin приложения, без пути и завершающего слэша.
APP_ORIGIN=http://localhost:3000

# Seed: свой email и уникальный пароль не короче 12 символов.
ADMIN_EMAIL=
ADMIN_NAME="Администратор"
ADMIN_PASSWORD=

SERVICE_NAME="Автосервис"
TIMEZONE=Europe/Kaliningrad
